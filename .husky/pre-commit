# Local-dev gate only. CI enforces build, tests, and clippy through the Test
# workflow (.github/workflows/test.yml), which installs the clippy component.
# The changesets release job makes an automated version-bump commit with no Rust
# toolchain set up, so these checks must not run there.
if [ -n "$CI" ]; then
  exit 0
fi

bun biome check --write --staged --no-errors-on-unmatched
cargo clippy -- -D warnings
cargo fmt --check
